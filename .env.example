# Copy to .env at the repository root. Every app and the Prisma CLI read this one file.
# Values match infra/docker/docker-compose.dev.yml and are for local development only.

DATABASE_URL="postgresql://mail:mail@localhost:5432/mail_service?schema=public"
REDIS_URL="redis://localhost:6379"

# Domain that generated inbox addresses use; seeded into the domains table.
MAIL_DOMAIN="mail.localhost"

# Copy to .env at the repository root. Every app and the Prisma CLI read this one file.
# Values match infra/docker/docker-compose.dev.yml and are for local development only.

DATABASE_URL="postgresql://mail:mail@localhost:5432/mail_service?schema=public"
REDIS_URL="redis://localhost:6379"

# Domain that generated inbox addresses use; seeded into the domains table.
MAIL_DOMAIN="mail.localhost"

# HMAC key for session tokens and IP hashes. At least 32 characters; changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SERVER_PEPPER="dev-only-pepper-change-me-in-production-0000"

# Number of reverse proxies in front of the API (1 behind Nginx) so rate limits see the real client IP.
TRUST_PROXY_HOPS=0

# S3-compatible object storage (RustFS in docker-compose.dev.yml) for raw .eml files and attachments.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="mailservice"
S3_SECRET_KEY="mailservice-dev-secret"
S3_BUCKET="mail-service"

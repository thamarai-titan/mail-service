{
  "name": "mail-service",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "infra:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:seed": "pnpm --filter @repo/database db:seed",
    "db:fake-mail": "pnpm --filter @repo/database db:fake-mail",
    "mail:test": "pnpm --filter worker mail:test",
    "maintenance:run": "pnpm --filter worker maintenance:run"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
